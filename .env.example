# Template variabel rahasia untuk ChainFund.
# Salin file ini jadi ".env" lalu isi nilainya. JANGAN commit file ".env".
#
#   cp .env.example .env   (atau copy manual)

# URL RPC node Ethereum untuk deploy ke testnet Sepolia.
# Bisa didapat gratis dari Alchemy (https://alchemy.com) atau Infura (https://infura.io).
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/ISI_API_KEY_KAMU

# Private key wallet untuk deploy (PAKAI WALLET KHUSUS TESTING, bukan wallet utama!).
# Private key = akses penuh ke wallet. Jangan pernah bagikan atau commit.
PRIVATE_KEY=isi_private_key_wallet_testing_kamu

# (Opsional) API key Etherscan untuk verifikasi contract di explorer.
# Didapat dari https://etherscan.io/myapikey
ETHERSCAN_API_KEY=isi_api_key_etherscan_kalau_mau_verifikasi
